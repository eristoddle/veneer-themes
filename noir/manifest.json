{
  "id": "noir",
  "name": "Noir",
  "version": "1.0.0",
  "description": "A high-contrast film still: near-black and white with one deep red accent, in Libre Baskerville with Playfair Display headings.",
  "apiVersion": "^0.60.0",
  "contributes": {
    "themes": [
      {
        "id": "noir:noir",
        "name": "Noir",
        "codeTheme": "noir:code",
        "fonts": {
          "body": {
            "family": "Libre Baskerville",
            "files": [
              {
                "path": "fonts/libre-baskerville-latin-400-normal.woff2",
                "weight": 400,
                "style": "normal"
              },
              {
                "path": "fonts/libre-baskerville-latin-400-italic.woff2",
                "weight": 400,
                "style": "italic"
              },
              {
                "path": "fonts/libre-baskerville-latin-700-normal.woff2",
                "weight": 700,
                "style": "normal"
              }
            ]
          },
          "heading": {
            "family": "Playfair Display",
            "files": [
              {
                "path": "fonts/playfair-display-latin-400-normal.woff2",
                "weight": 400,
                "style": "normal"
              },
              {
                "path": "fonts/playfair-display-latin-700-normal.woff2",
                "weight": 700,
                "style": "normal"
              }
            ]
          }
        },
        "light": {
          "page": "#FFFFFF",
          "text": "#0A0A0A",
          "text-muted": "#4A4A4A",
          "text-subtle": "#6E6E6E",
          "accent": "#A5141A",
          "accent-hover": "#7F0E13",
          "accent-tint": "rgba(165, 20, 26, 0.12)",
          "surface-panel": "#F2F2F2",
          "surface-control": "#E6E6E6",
          "surface-overlay": "#FFFFFF",
          "rule": "#D8D8D8",
          "divider": "#E9E9E9"
        },
        "dark": {
          "page": "#0A0A0A",
          "text": "#F2F2F2",
          "text-muted": "#BDBDBD",
          "text-subtle": "#8C8C8C",
          "accent": "#E0383E",
          "accent-hover": "#F0575C",
          "accent-tint": "rgba(224, 56, 62, 0.16)",
          "surface-panel": "#141414",
          "surface-control": "#202020",
          "surface-overlay": "#202020",
          "rule": "#2F2F2F",
          "divider": "#1F1F1F"
        }
      },
      {
        "id": "noir:code",
        "name": "Noir code",
        "scope": "code",
        "light": {
          "surface-code": "#F2F2F2",
          "syntax-keyword": "#A5141A",
          "syntax-string": "#3A3A3A",
          "syntax-comment": "#6E6E6E",
          "syntax-number": "#7A4A00",
          "syntax-function": "#1A1A1A",
          "syntax-type": "#555555",
          "syntax-variable": "#0A0A0A",
          "syntax-operator": "#4A4A4A",
          "syntax-punctuation": "#4A4A4A",
          "syntax-tag": "#A5141A",
          "syntax-attribute": "#7A4A00"
        },
        "dark": {
          "surface-code": "#141414",
          "syntax-keyword": "#F0575C",
          "syntax-string": "#C8C8C8",
          "syntax-comment": "#8C8C8C",
          "syntax-number": "#E8B86A",
          "syntax-function": "#F2F2F2",
          "syntax-type": "#A8A8A8",
          "syntax-variable": "#F2F2F2",
          "syntax-operator": "#BDBDBD",
          "syntax-punctuation": "#BDBDBD",
          "syntax-tag": "#F0575C",
          "syntax-attribute": "#E8B86A"
        }
      }
    ]
  }
}

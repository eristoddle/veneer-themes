          "syntax-string": "#F6C177",
          "syntax-comment": "#6E6A86",
          "syntax-number": "#EB6F92",
          "syntax-function": "#9CCFD8",
          "syntax-type": "#EBBCBA",
          "syntax-variable": "#E0DEF4",
          "syntax-operator": "#908CAA",
          "syntax-punctuation": "#908CAA",
          "syntax-tag": "#9CCFD8",

          "surface-panel": "#FFFAF3",
          "surface-control": "#F2E9E1"
        },
        "dark": {
          "page": "#191724",
          "text": "#E0DEF4",
          "text-muted": "#908CAA",
          "text-subtle": "#6E6A86",
          "accent": "#EBBCBA",
          "accent-hover": "#F2CDCB",
          "accent-tint": "rgba(235, 188, 186, 0.16)",

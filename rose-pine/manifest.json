{
  "id": "rose-pine",
  "name": "Rosé Pine",
  "version": "1.0.0",
  "apiVersion": "^0.48.0",
  "contributes": {
    "themes": [
      {
        "id": "rose-pine:rose-pine",
        "name": "Rosé Pine",
